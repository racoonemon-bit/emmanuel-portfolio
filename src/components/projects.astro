---
const trueWordsProject = {
  id: "true-words",
  title: "True Words Podcast: Studio Editorial & Video Repurposing",
  domain: "Episodic Media Production & AI Video Repurposing",
  role: "AI Video Producer & Editorial Architect",
  status: "Completed Production Masters",
  headline: "Transforming 10 raw studio clips into a high-retention 76-second narrative arc using documentary editorial grammar.",
  description: "Built an end-to-end video repurposing engine overcoming single-camera static framing through scripted punch-ins (1.04x–1.28x), J-cut dialogue bridges, verbatim color-sampled kinetic typography, and broadcast-grade acoustic engineering.",
  technicalSpecs: [
    "Whisper Speech Alignment",
    "J-Cut Audio Bridges (60–120ms)",
    "Motivated Punch-Ins (1.04x–1.28x)",
    "-15dB Dynamic Music Ducking",
    "+2.2dB Vocal EQ @ 3.2kHz",
    "Zero-Template Kinetic Subtitles",
  ],
  fullMasterVideo: {
    title: "Full 76s Master Episode (1080p Landscape)",
    src: "/assets/videos/true-words-youtube-full-episode-1080p.mp4",
    poster: "/assets/images/true-words-youtube-full-episode-1080p-poster.jpg",
    duration: "1:16",
  },
  shorts: [
    {
      title: "Short 01: Episode Hook",
      tag: "Thesis Statement",
      src: "/assets/videos/true-words-short-01-episode-hook-9x16.mp4",
      poster: "/assets/images/true-words-short-01-episode-hook-9x16-poster.jpg",
      duration: "0:25",
    },
    {
      title: "Short 02: Hero Quote",
      tag: "Emotional Centerpiece",
      src: "/assets/videos/true-words-short-02-hero-quote-9x16.mp4",
      poster: "/assets/images/true-words-short-02-hero-quote-9x16-poster.jpg",
      duration: "0:16",
    },
    {
      title: "Short 03: Growth Routine",
      tag: "Philosophical Resolution",
      src: "/assets/videos/true-words-short-03-growth-routine-9x16.mp4",
      poster: "/assets/images/true-words-short-03-growth-routine-9x16-poster.jpg",
      duration: "0:22",
    },
  ],
