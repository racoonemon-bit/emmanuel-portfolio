const aiGraphicsProject = {
  id: "ai-graphics-blueprint",
  title: "AI Graphics Business Blueprint & Direct-Response System",
  domain: "Performance Creative Strategy & Generative Visual Systems",
  role: "Performance Creative Strategist & AI Producer",
  status: "Production Blueprint & Framework",
  headline: "Structured operational framework translating consumer psychological friction points into 3-second visual hooks.",
  description: "Engineered rapid variant testing matrices (5 visual hooks across 3 benefit angles) with multi-modal prompt pipelines, automated typography, and audio normalization to deliver paid social creatives within 24–48 hours.",
  technicalSpecs: [
    "Hook Engineering Architecture",
    "Creative Cockpit Matrices",
    "Multi-Modal Prompt Pipelines",
    "Automated Typography & Layout",
    "24–48h Production Delivery",
    "Asset Scaling Framework",
  ],
  coverImage: "/assets/images/ai-graphics-blueprint-cover.png",
  gallery: [
    {
      title: "Blueprint Framework",
      src: "/assets/images/ai-graphics-blueprint-framework.png",
      caption: "Architecture & Foundation",
    },
    {
      title: "Execution Matrix",
      src: "/assets/images/ai-graphics-blueprint-execution.png",
      caption: "Variant Scaling & Hook Testing",
    },
    {
      title: "Process Pipeline",
      src: "/assets/images/ai-graphics-blueprint-process.png",
      caption: "Prompt-to-Delivery Operations",
    },
    {
      title: "System Overview",
      src: "/assets/images/ai-graphics-blueprint-system.png",
      caption: "Multi-Channel Distribution",
    },
  ],
};
---

<section id="projects" class="py-16 border-t border-[#ffffff10] text-[var(--white)] scroll-mt-24">
  <div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="mb-12 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-full bg-[var(--sec)]"></span>
          <h2 class="text-xs font-mono uppercase tracking-widest text-[var(--sec)] shiny-sec">
            Documented Case Studies
          </h2>
        </div>
        <h3 class="text-3xl md:text-5xl font-medium tracking-tight">
          Featured Projects
        </h3>
      </div>
      <p class="text-sm md:text-base text-[var(--white-icon)] max-w-md">
        Verified creative pipelines and production architectures executed by Emmanuel Umaru.
      </p>
    </div>

    <!-- Case Study 01: True Words Podcast -->
    <div class="mb-16 rounded-3xl border border-white/10 bg-[#14141460] backdrop-blur-md overflow-hidden p-6 md:p-8 hover:border-[var(--sec)]/40 transition-all duration-300">
      <!-- Project Metadata -->
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-[var(--sec)]/20 text-[#caa8ff] border border-[var(--sec)]/30">
          Case Study 01
        </span>
        <span class="text-xs font-mono text-[var(--white-icon)]">
          {trueWordsProject.domain}
        </span>
      </div>

      <h4 class="text-2xl md:text-3xl font-semibold text-white mb-2 leading-tight">
        {trueWordsProject.title}
      </h4>

      <p class="text-sm md:text-base text-[var(--white-icon)] mb-6 max-w-3xl leading-relaxed">
        {trueWordsProject.description}
      </p>

      <!-- 16:9 Full Episode Master Video Player -->
      <div class="mb-8 rounded-2xl overflow-hidden border border-white/10 bg-black relative group">
        <video
          id="true-words-master"
          class="w-full aspect-video object-cover"
          poster={trueWordsProject.fullMasterVideo.poster}
          preload="metadata"
          playsinline
        >
          <source src={trueWordsProject.fullMasterVideo.src} type="video/mp4" />
          Your browser does not support video.
        </video>

        <!-- Video Play Overlay -->
        <button
          type="button"
          class="project-play-btn absolute inset-0 w-full h-full flex items-center justify-center bg-black/30 hover:bg-black/10 transition-colors group cursor-pointer"
          data-video-id="true-words-master"
          aria-label="Play True Words Full Episode"
        >
          <div class="size-16 md:size-20 rounded-full bg-white/15 backdrop-blur-md border border-white/30 flex items-center justify-center text-white shadow-2xl transition-all duration-300 group-hover:scale-110 group-hover:bg-[var(--sec)]/80">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 md:size-10 translate-x-0.5 play-icon">
              <path d="M8 5v14l11-7z" />
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 md:size-10 pause-icon hidden">
              <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
            </svg>
          </div>
        </button>

        <!-- Player Badges -->
        <div class="absolute bottom-3 right-3 flex items-center gap-2 z-10">
          <span class="px-2.5 py-1 rounded-md bg-black/70 backdrop-blur-md text-white text-xs font-mono border border-white/10">
            {trueWordsProject.fullMasterVideo.title} • {trueWordsProject.fullMasterVideo.duration}
          </span>
        </div>
      </div>

      <!-- Vertical Shorts Row (9:16) -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-4">
          <h5 class="text-sm font-semibold text-white uppercase font-mono tracking-wider">
            Short-Form Episodic Cuts (9:16 Vertical)
          </h5>
          <span class="text-xs text-[var(--white-icon)] font-mono">3 Multi-Format Deliverables</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {trueWordsProject.shorts.map((short, idx) => (
            <div class="rounded-xl border border-white/10 bg-[#121212] overflow-hidden flex flex-col justify-between group/short">
              <div class="relative bg-black">
                <video
                  id={`tw-short-${idx}`}
                  class="w-full h-64 md:h-72 object-cover"
                  poster={short.poster}
                  preload="metadata"
                  playsinline
                >
                  <source src={short.src} type="video/mp4" />
                </video>

                <button
                  type="button"
                  class="project-play-btn absolute inset-0 w-full h-full flex items-center justify-center bg-black/30 hover:bg-black/10 transition-colors cursor-pointer"
                  data-video-id={`tw-short-${idx}`}
                  aria-label={`Play ${short.title}`}
                >
                  <div class="size-10 rounded-full bg-white/20 backdrop-blur-md border border-white/30 flex items-center justify-center text-white transition-transform group-hover/short:scale-110 group-hover/short:bg-[var(--sec)]">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 translate-x-0.5 play-icon">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 pause-icon hidden">
                      <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
                    </svg>
                  </div>
                </button>

                <div class="absolute top-2 left-2 z-10">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-black/70 text-white border border-white/10">
                    {short.tag}
                  </span>
                </div>

                <div class="absolute bottom-2 right-2 z-10">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-black/70 text-white">
                    {short.duration}
                  </span>
                </div>
              </div>

              <div class="p-3">
                <h6 class="text-xs font-semibold text-white">{short.title}</h6>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Technical Architecture Badges -->
      <div class="flex flex-wrap gap-2 pt-4 border-t border-white/10">
        {trueWordsProject.technicalSpecs.map((spec) => (
          <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-white/5 border border-white/5 text-[var(--white-icon)]">
            {spec}
          </span>
        ))}
      </div>
    </div>

    <!-- Case Study 02: AI Graphics Business Blueprint -->
    <div class="rounded-3xl border border-white/10 bg-[#14141460] backdrop-blur-md overflow-hidden p-6 md:p-8 hover:border-[var(--sec)]/40 transition-all duration-300">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-[var(--sec)]/20 text-[#caa8ff] border border-[var(--sec)]/30">
          Case Study 02
        </span>
        <span class="text-xs font-mono text-[var(--white-icon)]">
          {aiGraphicsProject.domain}
        </span>
      </div>

      <h4 class="text-2xl md:text-3xl font-semibold text-white mb-2 leading-tight">
        {aiGraphicsProject.title}
      </h4>

      <p class="text-sm md:text-base text-[var(--white-icon)] mb-6 max-w-3xl leading-relaxed">
        {aiGraphicsProject.description}
      </p>

      <!-- Featured Master Blueprint Graphic -->
      <div class="mb-6 rounded-2xl overflow-hidden border border-white/10 bg-[#181818]">
        <img
          src={aiGraphicsProject.coverImage}
          alt={aiGraphicsProject.title}
          class="w-full h-auto max-h-[500px] object-cover hover:scale-[1.01] transition-transform duration-500"
          loading="lazy"
        />
      </div>

      <!-- Sub-Graphics Gallery -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-4">
          <h5 class="text-sm font-semibold text-white uppercase font-mono tracking-wider">
            System Artifacts & Execution Matrices
          </h5>
          <span class="text-xs text-[var(--white-icon)] font-mono">4 Architecture Plates</span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {aiGraphicsProject.gallery.map((item) => (
            <div class="rounded-xl border border-white/10 bg-[#121212] overflow-hidden group/art">
              <div class="overflow-hidden aspect-video bg-[#0c0c0c]">
                <img
                  src={item.src}
                  alt={item.title}
                  class="w-full h-full object-cover group-hover/art:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <div class="p-2.5">
                <h6 class="text-xs font-semibold text-white truncate">{item.title}</h6>
                <p class="text-[11px] text-[var(--white-icon)] truncate">{item.caption}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Technical Tags -->
      <div class="flex flex-wrap gap-2 pt-4 border-t border-white/10">
        {aiGraphicsProject.technicalSpecs.map((spec) => (
          <span class="px-2.5 py-1 rounded-md text-xs font-mono bg-white/5 border border-white/5 text-[var(--white-icon)]">
            {spec}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Project Video Playback
  document.addEventListener("DOMContentLoaded", () => {
    const playButtons = document.querySelectorAll<HTMLButtonElement>(".project-play-btn");

    playButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const videoId = btn.getAttribute("data-video-id");
        if (!videoId) return;

        const video = document.getElementById(videoId) as HTMLVideoElement | null;
        if (!video) return;

        const playIcon = btn.querySelector(".play-icon");
        const pauseIcon = btn.querySelector(".pause-icon");

        if (video.paused) {
          // Pause other videos
          document.querySelectorAll<HTMLVideoElement>("video").forEach((v) => {
            if (v !== video && !v.paused) {
              v.pause();
              const otherBtn = document.querySelector(`.project-play-btn[data-video-id="${v.id}"]`);
              if (otherBtn) {
                otherBtn.querySelector(".play-icon")?.classList.remove("hidden");
                otherBtn.querySelector(".pause-icon")?.classList.add("hidden");
              }
            }
          });

          video.play().then(() => {
            playIcon?.classList.add("hidden");
            pauseIcon?.classList.remove("hidden");
          }).catch(() => {});
        } else {
          video.pause();
          playIcon?.classList.remove("hidden");
          pauseIcon?.classList.add("hidden");
        }
      });
    });

    document.querySelectorAll<HTMLVideoElement>("video").forEach((v) => {
      v.addEventListener("ended", () => {
        const btn = document.querySelector(`.project-play-btn[data-video-id="${v.id}"]`);
        if (btn) {
          btn.querySelector(".play-icon")?.classList.remove("hidden");
          btn.querySelector(".pause-icon")?.classList.add("hidden");
        }
      });
    });
  });
</script>
