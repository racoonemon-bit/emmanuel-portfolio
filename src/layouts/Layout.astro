---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | AI Creative & Digital Specialist</title>
    <meta
      name="description"
      content="Emmanuel Umaru — AI Creative & Digital Specialist (UTC+1 · Remote Worldwide). Generative visual production, episodic video repurposing, AI workflow automation, and Web3 creative direction."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://emmanuelumaru.dev/" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Emmanuel Umaru | AI Creative & Digital Specialist"
    />
    <meta
      property="og:description"
      content="Bridging creative storytelling, visual design, and generative AI automation to build high-impact digital experiences and streamlined production pipelines."
    />
    <meta property="og:image" content="/assets/images/ai-graphics-blueprint-cover.png" />
    <meta property="og:url" content="https://emmanuelumaru.dev" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Emmanuel Umaru Portfolio"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Emmanuel Umaru",
        "jobTitle": "AI Creative & Digital Specialist",
        "email": "emmanuelumaru945@gmail.com",
        "telephone": "+23488033109348",
        "url": "https://emmanuelumaru.dev",
        "description": "AI Creative & Digital Specialist specializing in generative visual production, video repurposing, workflow automation, and digital media."
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --component-bg: #141414e6;
    --sec: #a476ff;
    --sec-glow: rgba(164, 118, 255, 0.15);
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */
  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: var(--background);
  }

  ::-webkit-scrollbar-thumb {
    background: #252525;
    border-radius: 8px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: #252525 var(--background);
  }
</style>
